{
  "version": 2,
  "functions": {
    "api/search.js": {
      "runtime": "nodejs22.x",
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search.js"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}